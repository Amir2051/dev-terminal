# Keep local mode for the existing private Kali dashboard. SaaS mode is not a production-ready workspace service yet.
APP_MODE=local
PROJECTS_DIR=~/Projects
GITHUB_TOKEN=github_pat_replace_me
APP_HOST=127.0.0.1
APP_PORT=8000

# Supabase Auth (the publishable/anon key is public; NEVER put a service-role/secret key here).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required for SaaS agent pairing in hosted/multi-worker deployments (Upstash Redis REST).
# Keep the token server-side; the API fails closed if shared rate limiting is not configured.
PAIRING_RATE_LIMIT_REST_URL=
PAIRING_RATE_LIMIT_REST_TOKEN=

# Required in SaaS mode. Hostnames only for ALLOWED_HOSTS; exact origins for APP_ORIGINS.
# Example: ALLOWED_HOSTS=dev-terminal.example.com
# Example: APP_ORIGINS=https://dev-terminal.example.com
ALLOWED_HOSTS=
APP_ORIGINS=

TTYD_HOST=127.0.0.1
TTYD_PORT=7681
TTYD_USER=dev
TTYD_PASSWORD=replace-with-a-long-random-password
# Generate a separate random secret, for example: openssl rand -hex 32
TERMINAL_QUEUE_TOKEN=replace-with-a-separate-random-secret

# Optional GitHub MCP integration. Keep the token in your private .env only.
# Non-secret owner used as the default query for complete repository inventory.
RZ_GITHUB_OWNER=Amir2051
# Create a fine-grained PAT with read-only access to selected repositories.
RZ_MCP_ALLOW_REMOTE=0
RZ_GITHUB_MCP_TOKEN=
